# Helios configuration.
#
# Copy to .env and adjust. Every value here is a non-secret default suitable for
# local development. Real credentials belong in a secrets manager, never in this
# file or in source control.

# ------------------------------------------------------------- environment --
HELIOS_ENVIRONMENT=local
HELIOS_DEBUG=false
HELIOS_LOG_LEVEL=INFO
HELIOS_LOG_FORMAT=console

# ---------------------------------------------------------------- database --
HELIOS_DATABASE_URL=postgresql+psycopg://helios:helios@localhost:5432/helios

# Used by the integration test suite. Must be a separate database: the suite
# drops and recreates the schema.
HELIOS_TEST_DATABASE_URL=postgresql+psycopg://helios:helios@localhost:5432/helios_test

# ---------------------------------------------------------- evidence store --
# "filesystem" for local development, "s3" for MinIO or AWS.
HELIOS_EVIDENCE_BACKEND=filesystem
HELIOS_EVIDENCE_ROOT=./data/evidence-store

# Only read when HELIOS_EVIDENCE_BACKEND=s3.
HELIOS_EVIDENCE_BUCKET=helios-evidence
HELIOS_S3_ENDPOINT_URL=http://localhost:9000
HELIOS_S3_REGION=us-west-2
# AWS credentials come from the standard provider chain (environment, profile,
# or instance role). Do not put them here.

# --------------------------------------------------------------- ingestion --
# Identify the crawler honestly and contactably. Several agencies block
# unidentified clients, and doing so is the polite default regardless.
HELIOS_USER_AGENT=ProjectHelios/0.1 (open public-infrastructure research; +https://github.com/varad-more/us-data-center-observatory)

HELIOS_HTTP_TIMEOUT_SECONDS=60
HELIOS_HTTP_MAX_RETRIES=4
HELIOS_DEFAULT_RATE_LIMIT_PER_SECOND=2

# Master switch. Set false to guarantee no connector reaches the network.
HELIOS_ALLOW_LIVE_FETCH=true

# ------------------------------------------------------------------ ethics --
# Suppress owner names classified as private individuals before they are stored.
# Turning this off is a decision with legal and ethical consequences; the
# published deployment must leave it on.
HELIOS_REDACT_NATURAL_PERSON_NAMES=true
HELIOS_REDACT_OWNER_MAILING_ADDRESSES=true

# ------------------------------------------------------------------- study --
HELIOS_STUDY_REGION_SLUG=east-valley-az
# min_lon, min_lat, max_lon, max_lat covering Mesa through Apache Junction.
HELIOS_STUDY_REGION_BBOX=[-111.98,33.16,-111.35,33.52]

# --------------------------------------------------------------------- api --
HELIOS_API_CORS_ORIGINS=["http://localhost:3000"]

# Bearer token guarding /admin routes. When unset, admin routes are refused
# outright rather than left open. Generate with: openssl rand -hex 32
HELIOS_ADMIN_API_TOKEN=

# --------------------------------------------------------------- frontend ---
NEXT_PUBLIC_HELIOS_API_URL=http://127.0.0.1:8000
